{
  "$schema": "http://json.schemastore.org/template",
  "author": "Macro Deck",
  "classifications": [
    "Macro Deck",
    "Plugin",
    "Console"
  ],
  "identity": "MacroDeck.Plugin.Template.CSharp",
  "name": "Macro Deck plugin",
  "shortName": "macrodeck-plugin",
  "description": "A minimal out-of-process Macro Deck 3 plugin: one integration, one localized action, and the developer tooling wired up.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "MacroDeck.PluginTemplate",
  "defaultName": "MacroDeckPlugin",
  "preferNameDirectory": true,
  "symbols": {
    "pluginId": {
      "type": "parameter",
      "datatype": "string",
      "description": "The manifest id: reverse-domain, lowercase, at least two dot-joined kebab segments.",
      "defaultValue": "com.example.my-plugin",
      "replaces": "app.macro-deck.template"
    },
    "pluginName": {
      "type": "parameter",
      "datatype": "string",
      "description": "The display name Macro Deck shows for the plugin.",
      "defaultValue": "My Plugin",
      "replaces": "Macro Deck Plugin Template"
    },
    "publisher": {
      "type": "parameter",
      "datatype": "string",
      "description": "The publisher's display name, written to manifest 'publisher.name'.",
      "defaultValue": "Example Publisher",
      "replaces": "Example Publisher"
    },
    "description": {
      "type": "parameter",
      "datatype": "string",
      "description": "A short description of the plugin, written to manifest 'description'.",
      "defaultValue": "A minimal Macro Deck 3 plugin.",
      "replaces": "A minimal Macro Deck 3 plugin."
    },
    "license": {
      "type": "parameter",
      "datatype": "string",
      "description": "An SPDX license identifier for manifest 'license'. Replace the LICENSE file yourself if this is not MIT.",
      "defaultValue": "MIT",
      "replaces": "MIT"
    },
    "repository": {
      "type": "parameter",
      "datatype": "string",
      "description": "The GitHub repository the plugin is built from, written to manifest 'repository'. The Store refuses an upload whose repository is not the one it was built in.",
      "defaultValue": "https://github.com/example/my-plugin",
      "replaces": "https://github.com/example/my-plugin"
    },
    "homepage": {
      "type": "parameter",
      "datatype": "string",
      "description": "The project homepage URL. Omitted from the manifest when empty; the schema rejects an empty string.",
      "defaultValue": "",
      "replaces": "https://example.com/my-plugin"
    },
    "platforms": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "description": "The runtime identifiers to emit into 'entrypoints' and 'macrodeck-build.json'. Repeat the option for each one.",
      "defaultValue": "win-x64|osx-arm64|linux-x64",
      "choices": [
        {
          "choice": "win-x64",
          "description": "Windows on x64."
        },
        {
          "choice": "win-arm64",
          "description": "Windows on ARM64. Falls back to win-x64 when absent."
        },
        {
          "choice": "osx-arm64",
          "description": "macOS on Apple silicon. Falls back to osx-x64 when absent."
        },
        {
          "choice": "osx-x64",
          "description": "macOS on Intel."
        },
        {
          "choice": "linux-x64",
          "description": "Linux on x64."
        },
        {
          "choice": "linux-arm64",
          "description": "Linux on ARM64."
        }
      ]
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Skip the automatic restore after the project is created.",
      "defaultValue": "false"
    },
    "hasHomepage": {
      "type": "computed",
      "value": "homepage != \"\""
    },
    "winX64": {
      "type": "computed",
      "value": "platforms == \"win-x64\""
    },
    "winArm64": {
      "type": "computed",
      "value": "platforms == \"win-arm64\""
    },
    "osxArm64": {
      "type": "computed",
      "value": "platforms == \"osx-arm64\""
    },
    "osxX64": {
      "type": "computed",
      "value": "platforms == \"osx-x64\""
    },
    "linuxX64": {
      "type": "computed",
      "value": "platforms == \"linux-x64\""
    },
    "linuxArm64": {
      "type": "computed",
      "value": "platforms == \"linux-arm64\""
    },
    "commaAfterWinX64": {
      "type": "computed",
      "value": "winArm64 || osxArm64 || osxX64 || linuxX64 || linuxArm64"
    },
    "commaAfterWinArm64": {
      "type": "computed",
      "value": "osxArm64 || osxX64 || linuxX64 || linuxArm64"
    },
    "commaAfterOsxArm64": {
      "type": "computed",
      "value": "osxX64 || linuxX64 || linuxArm64"
    },
    "commaAfterOsxX64": {
      "type": "computed",
      "value": "linuxX64 || linuxArm64"
    },
    "commaAfterLinuxX64": {
      "type": "computed",
      "value": "linuxArm64"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".github/**",
            ".idea/**",
            ".vs/**",
            "packaging/**",
            "**/bin/**",
            "**/obj/**",
            "**/.macrodeck-dev-state/**",
            "**/.DS_Store",
            "local-feed/*.nupkg",
            "local-feed/*.snupkg",
            "conformance.md",
            "*.macroDeckPlugin",
            "src/MacroDeck.PluginTemplate/manifest.json",
            "src/MacroDeck.PluginTemplate/macrodeck-build.json"
          ],
          "copyOnly": [
            "**/*.svg",
            "**/*.resx",
            "**/.gitkeep",
            "LICENSE"
          ]
        }
      ]
    },
    {
      "source": "./.template.config/content/",
      "target": "./src/MacroDeck.PluginTemplate/",
      "include": [
        "manifest.json",
        "macrodeck-build.json"
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "src/MacroDeck.PluginTemplate/MacroDeck.PluginTemplate.csproj"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
